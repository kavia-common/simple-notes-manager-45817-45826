# PUBLIC_INTERFACE
# Example environment variables for Slidev notes_frontend
# Copy to .env and adjust as needed. Do not commit secrets.

# Port for Vite/Slidev dev server (used in scripts and vite.config.ts)
VITE_PORT=3000

# Optional feature flags consumed by pages/notes-app.md
# Provide as a JSON string, e.g. {"betaUI":true}
VITE_FEATURE_FLAGS={"betaUI":false}

# Common placeholders (not required for this project, but included for consistency)
VITE_API_BASE=
VITE_BACKEND_URL=
VITE_FRONTEND_URL=
VITE_WS_URL=
VITE_NODE_ENV=development
VITE_NEXT_TELEMETRY_DISABLED=1
VITE_ENABLE_SOURCE_MAPS=0
VITE_TRUST_PROXY=1
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/index.html
VITE_EXPERIMENTS_ENABLED=0
