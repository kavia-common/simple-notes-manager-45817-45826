# Optional runtime vars used by Vite/Slidev (not required for local notes storage)
VITE_API_BASE=
VITE_BACKEND_URL=
VITE_FRONTEND_URL=
VITE_WS_URL=
VITE_NODE_ENV=development
VITE_ENABLE_SOURCE_MAPS=false
VITE_PORT=3000
VITE_TRUST_PROXY=false
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/health
# JSON string for feature flags, e.g. {"betaBanner":true}
VITE_FEATURE_FLAGS={}
VITE_EXPERIMENTS_ENABLED=false
